{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "ffmpeg",
					"version": "7:4.2.7-0ubuntu0.1"
				},
				{
					"name": "libsm6",
					"version": "2:1.2.3-1"
				},
				{
					"name": "libxext6",
					"version": "2:1.3.4-0ubuntu1"
				}
			],
			"install_software_properties_common": true
		},
		"pip": {
			"packages": [
				{
					"name": "aind-data-schema",
					"version": "1.4.0"
				},
				{
					"name": "aind-metadata-upgrader"
				},
				{
					"name": "gdown",
					"version": "5.2.0"
				},
				{
					"name": "h5py",
					"version": "3.14.0"
				},
				{
					"name": "imageio",
					"version": "2.37.0"
				},
				{
					"name": "matplotlib",
					"version": "3.9.4"
				},
				{
					"name": "opencv-python",
					"version": "4.11.0.86"
				},
				{
					"name": "scipy",
					"version": "1.13.1"
				},
				{
					"name": "tensorflow",
					"version": "2.19.0"
				},
				{
					"name": "uv",
					"version": "0.7.15"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
}